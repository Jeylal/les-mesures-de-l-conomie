label = "Les mêmes individus dominent\nrevenu du capital ET\nrevenu du travail",
size = 3, hjust = 0.5, color = "#2980b9", lineheight = 1.2) +
# --- exemples en italique ---
annotate("text", x = -0.88, y = 0.42,
label = "Europe 19ème s.", fontface = "italic",
size = 3, hjust = 0.5, color = "#c0392b") +
annotate("text", x =  0.88, y = 0.42,
label = "États-Unis, Chine contemp.", fontface = "italic",
size = 3, hjust = 0.5, color = "#2980b9") +
# --- flèche "inégalité de composition décroissante" ---
geom_segment(aes(x = -0.85, xend = 0.85, y = 0.65, yend = 0.65),
linewidth = 0.5, color = "grey55",
arrow = arrow(ends = "right", length = unit(0.22, "cm"))) +
annotate("text", x = 0, y = 0.78,
label = "Inégalité compositionnelle décroissante",
size = 3, hjust = 0.5, color = "grey50", fontface = "italic") +
xlim(-1.4, 1.4) +
ylim(-0.75, 0.95) +
theme_void()

library(ggplot2)
ggplot() +
# --- axe principal ---
geom_segment(aes(x = -1.15, xend = 1.15, y = 0, yend = 0),
linewidth = 1, color = "grey25",
arrow = arrow(ends = "both", type = "closed",
length = unit(0.22, "cm"))) +
# --- ticks ---
geom_segment(aes(x = c(-1, 0, 1), xend = c(-1, 0, 1),
y = -0.07, yend = 0.07),
linewidth = c(1.2, 0.7, 1.2),
color = c("#c0392b", "grey50", "#2980b9")) +
# --- valeurs de κ ---
annotate("text", x = -1, y = -0.2,  label = "κ = −1",
size = 3.8, hjust = 0.5, color = "#c0392b") +
annotate("text", x =  0, y = -0.2,  label = "κ = 0",
size = 3.5, hjust = 0.5, color = "grey50") +
annotate("text", x =  1, y = -0.2,  label = "κ = +1",
size = 3.8, hjust = 0.5, color = "#2980b9") +
# --- noms des régimes (au-dessus) ---
annotate("text", x = -1, y = 0.22,
label = "Capitalisme classique",
size = 4.2, fontface = "bold", hjust = 0.5, color = "#c0392b") +
annotate("text", x =  1, y = 0.22,
label = "Homoploutie",
size = 4.2, fontface = "bold", hjust = 0.5, color = "#2980b9") +
# --- descriptions courtes (sous les ticks) ---
annotate("text", x = -1, y = -0.48,
label = "Capitalistes ≠ travailleurs\nRevenu du capital et du travail\nvont à des individus distincts",
size = 3, hjust = 0.5, color = "#c0392b", lineheight = 1.2) +
annotate("text", x =  1, y = -0.48,
label = "Les mêmes individus dominent\nrevenu du capital ET\nrevenu du travail",
size = 3, hjust = 0.5, color = "#2980b9", lineheight = 1.2) +
# --- exemples en italique ---
annotate("text", x = -0.88, y = 0.42,
label = "Europe 19ème s.", fontface = "italic",
size = 3, hjust = 0.5, color = "#c0392b") +
annotate("text", x =  0.88, y = 0.42,
label = "États-Unis, Chine contemp.", fontface = "italic",
size = 3, hjust = 0.5, color = "#2980b9") +
# --- flèche "inégalité de composition décroissante" ---
geom_segment(aes(x = -0.85, xend = 0.85, y = 0.65, yend = 0.65),
linewidth = 0.5, color = "grey55",

inc       = c(0.20, 0.40, 0.40)
) |>
mutate(
theil     = round(inc * log(inc / pop), 3),
direction = case_when(
inc > pop ~ "Sur-représenté (revenu > pop.)",
inc < pop ~ "Sous-représenté (revenu < pop.)",
TRUE      ~ "Équilibre (revenu = pop.)"
)
)
